# ==============================================================================
# SocialSentinel Unified Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env for local development or set in Vercel / Cloud Dashboard.
# NEVER commit real credentials, service keys, or production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Next.js App & Database)
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ------------------------------------------------------------------------------
# 2. Next.js App Router Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_LOCAL_AI=true

# ------------------------------------------------------------------------------
# 3. Python Flask & Inference Backend (Optional / Standalone)
# ------------------------------------------------------------------------------
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars
JWT_SECRET_KEY=replace-with-a-different-secret-key-at-least-32-chars
DATABASE_URL=sqlite:///data/socialsentinel_v4.db
CORS_ORIGINS=*
PYTHON_INFERENCE_URL=http://127.0.0.1:5000
SENTIMENT_MODEL=models/sentiment_model.pkl
TFIDF_VECTORIZER=models/tfidf_vectorizer.pkl
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
