# ==============================================================================
# SocialSentinel Production Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development or set in Vercel Dashboard.
# NEVER commit real credentials, service keys, or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Configuration (Required)
# ------------------------------------------------------------------------------
# Obtain these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Server-only Service Role Key (Used exclusively by seed scripts / background sync)
# DO NOT prefix with NEXT_PUBLIC_. Keep strictly private on trusted server environments.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Direct PostgreSQL Connection String (Used for running migrations & seed.mjs)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. Application & Authentication Settings
# ------------------------------------------------------------------------------
# The canonical URL used for Supabase Auth email confirmation and password reset callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_LOCAL_AI=true

# ------------------------------------------------------------------------------
# 3. Optional Standalone Python ML Inference Service (Legacy / High-Throughput)
# ------------------------------------------------------------------------------
# If running the legacy Flask service in app/ run on port 5000
PYTHON_INFERENCE_URL=http://127.0.0.1:5000
SENTIMENT_MODEL=models/sentiment_model.pkl
TFIDF_VECTORIZER=models/tfidf_vectorizer.pkl
